# Copiá este archivo como ".env" dentro de la carpeta sidecar/ y completá
# las claves. TODOS los proveedores del consejo son GRATUITOS.
# Los agentes sin clave aparecen en el debate con un aviso, pero la app
# sigue funcionando.

# Groq (rol Creativo) — clave gratis en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (rol Lógica + análisis de imágenes) — gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (modelos ":free": Técnico, Estratega y suplentes) — clave en https://openrouter.ai/keys
# Los endpoints gratuitos se saturan seguido: cada agente prueba su titular
# y después los alternativos, en orden, hasta que uno responda.
# La lista de modelos gratis vigentes está en https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL_TECNICO=openai/gpt-oss-120b:free
OPENROUTER_MODEL_ESTRATEGA=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODELS_ALTERNATIVOS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3-coder:free,nousresearch/hermes-3-llama-3.1-405b:free,meta-llama/llama-3.3-70b-instruct:free

# Ollama (Juez local, sin nube ni clave). Modelo: ollama pull llama3.1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Whisper local (voz): "base" es rápido, "small" es más preciso.
WHISPER_MODEL=base
WHISPER_IDIOMA=es
