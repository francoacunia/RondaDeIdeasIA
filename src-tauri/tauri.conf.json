{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ronda de ideas IA",
  "version": "0.1.0",
  "identifier": "com.fran.rondadeideas",
  "build": {
    "beforeDevCommand": "npm run dev:all",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ronda de ideas IA",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/ronda-sidecar"]
  }
}
